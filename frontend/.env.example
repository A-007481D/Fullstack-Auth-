# ─────────────────────────────────────────────────────────────────
# Frontend environment — Next.js
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Note: When running via Docker Compose, NEXT_PUBLIC_API_URL is
# set at BUILD TIME as a docker-compose.yml build arg.
# For local (non-Docker) Next.js development, set it here.
# ─────────────────────────────────────────────────────────────────

# URL the Next.js frontend uses to call the backend API.
# - Docker:    http://localhost:3000/api  (routed via Next.js rewrite to backend:8000)
# - Local dev: http://localhost:8000/api  (if running Laravel locally)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
